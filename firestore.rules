// Regras do Cardápio Delivery (várias lojas no mesmo projeto).
// Padrão em segundo-cerebro/padroes/dados-e-seguranca.md.
//
// - Cardápio, bairros e dados da loja: qualquer um lê; só o dono da loja escreve.
// - Pedido do cliente (anônimo): só cria, e só numa antessala da loja
//   (pedidosEntrada), no formato certo (crença 12). Ler, mudar e apagar é do dono.
// - Pedidos já aceitos (pedidos): o dono lê a lista e escreve.
// - O cliente acompanha o próprio pedido lendo pelo id (get, nunca a lista).
//   O id é aleatório e funciona como senha do pedido (decisão dele, 2026-10-15).
// - Dados pessoais do dono (donos/{uid}): só o próprio dono.
// - Usuários do painel (decisão dele, 2026-10-22): acessos/{email} liga um e-mail a uma
//   loja só. Quem tem acesso faz tudo o que o dono faz, menos apagar a loja. Ninguém
//   tira o acesso do dono nem o próprio. Excluir é apagar o acesso; a conta do Auth fica.
// - O id da loja é o link do cardápio (slug), então dois restaurantes não pegam o mesmo.
// - Qualquer outro caminho: fechado.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function donoDa(lojaId) {
      return logado() && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoId == request.auth.uid;
    }
    function meuEmail() { return request.auth.token.email.lower(); }
    // dono, ou alguém com acesso a esta loja (acessos/{email})
    function membroDa(lojaId) {
      return donoDa(lojaId) || (logado()
        && exists(/databases/$(database)/documents/acessos/$(meuEmail()))
        && get(/databases/$(database)/documents/acessos/$(meuEmail())).data.lojaId == lojaId);
    }
    function texto(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function centavos(v) { return v is int && v >= 0 && v <= 10000000; }

    // cupom do pedido (cupom.js): o desconto tem de ser exatamente o que o cupom dá,
    // só sobre os itens, com o cupom ligado, no prazo, dentro do limite e do mínimo
    function linhaDaOferta(a, b) {
      return a.itemId == b.itemId && a.qtd == b.qtd && a.nome == b.nome
        && a.escolhas == b.escolhas && a.resumo == b.resumo && a.total == b.total;
    }
    function cestaDaOferta(a, b) {
      return a.size() == b.size() && b.size() >= 1 && b.size() <= 3
        && linhaDaOferta(a[0], b[0])
        && (b.size() < 2 || linhaDaOferta(a[1], b[1]))
        && (b.size() < 3 || linhaDaOferta(a[2], b[2]));
    }
    function ofertaConfere(lojaId, d, id, c) {
      let vinculo = get(/databases/$(database)/documents/lojas/$(lojaId)/ofertasClientes/$(d.cupom)).data;
      let reserva = /databases/$(database)/documents/lojas/$(lojaId)/reservasCupons/$(d.cupom);
      return d.cliente.telefone == vinculo.telefone && c.limite == 1 && c.usos == 0
        && d.subtotal == c.subtotalOferta && cestaDaOferta(d.itens, c.oferta)
        && !exists(reserva) && getAfter(reserva).data.pedidoId == id
        && getAfter(reserva).data.criadoEm == request.time;
    }
    function cupomConfere(lojaId, d, id) {
      let c = get(/databases/$(database)/documents/lojas/$(lojaId)/cupons/$(d.cupom)).data;
      return d.cupom is string && d.cupom.matches("^[A-Z0-9]{3,20}$")
        && exists(/databases/$(database)/documents/lojas/$(lojaId)/cupons/$(d.cupom))
        && c.ativo == true
        && (c.get("validoAte", null) == null || request.time <= c.validoAte)
        && (c.get("limite", null) == null || c.get("usos", 0) < c.limite)
        && d.subtotal >= c.get("minimo", 0)
        && d.desconto == (c.tipo == "pct" ? math.round(d.subtotal * c.valor / 100.0) : (c.valor < d.subtotal ? c.valor : d.subtotal))
        && d.total == d.subtotal + d.taxa - d.desconto
        && (!c.get("individual", false) || ofertaConfere(lojaId, d, id, c));
    }

    match /lojas/{lojaId} {
      allow read: if true;
      allow create: if logado() && request.resource.data.donoId == request.auth.uid
        && request.resource.data.keys().hasOnly(["nome", "slug", "cidade", "bairro", "cor", "logoUrl", "donoId", "criadoEm"])
        && request.resource.data.slug == lojaId
        && lojaId.matches("^[a-z0-9-]{3,40}$")
        && texto(request.resource.data.nome, 120)
        && texto(request.resource.data.cidade, 60)
        && texto(request.resource.data.bairro, 60);
      allow update: if membroDa(lojaId) && request.resource.data.donoId == resource.data.donoId;
      allow delete: if donoDa(lojaId);

      match /categorias/{id} {
        allow read: if true;
        allow write: if membroDa(lojaId);
      }
      match /itens/{id} {
        allow read: if true;
        allow write: if membroDa(lojaId);
      }
      match /bairros/{id} {
        allow read: if true;
        allow write: if membroDa(lojaId);
      }

      // antessala: o cliente cria, o painel lê e move para "pedidos" com o mesmo id.
      // Loja pausada no painel (aberta == false) não recebe pedido. O cliente nunca
      // marca o pedido como pago: isso vem do provedor de pagamento, pelo servidor.
      match /pedidosEntrada/{id} {
        allow create: if exists(/databases/$(database)/documents/lojas/$(lojaId))
          && get(/databases/$(database)/documents/lojas/$(lojaId)).data.get("aberta", true) != false
          && request.resource.data.keys().hasOnly(["cliente", "tipo", "endereco", "itens", "subtotal", "taxa", "total", "pagamento", "status", "criadoEm", "cupom", "desconto"])
          && request.resource.data.status == "novo"
          && request.resource.data.criadoEm == request.time
          && request.resource.data.tipo in ["entrega", "retirada", "local"]
          && request.resource.data.itens is list
          && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 50
          && centavos(request.resource.data.subtotal)
          && centavos(request.resource.data.taxa)
          && (("cupom" in request.resource.data || "desconto" in request.resource.data)
            ? cupomConfere(lojaId, request.resource.data, id)
            : request.resource.data.total == request.resource.data.subtotal + request.resource.data.taxa)
          && texto(request.resource.data.cliente.nome, 80)
          && texto(request.resource.data.cliente.telefone, 20)
          && request.resource.data.pagamento is map
          && request.resource.data.pagamento.get("pago", false) == false;
        allow get: if true;
        allow list, update, delete: if membroDa(lojaId);
      }

      match /pedidos/{id} {
        allow get: if true;
        allow list, write: if membroDa(lojaId);
      }

      // cupons: quem tem o código lê (para conferir na sacola); a lista e a escrita são do dono
      match /cupons/{codigo} {
        allow get: if true;
        allow list, delete: if membroDa(lojaId);
        allow create, update: if membroDa(lojaId) && codigo.matches("^[A-Z0-9]{3,20}$")
          && request.resource.data.tipo in ["pct", "valor"]
          && request.resource.data.valor is int && request.resource.data.valor > 0
          && (request.resource.data.tipo == "valor" || request.resource.data.valor <= 100)
          && centavos(request.resource.data.minimo)
          && request.resource.data.ativo is bool
          && request.resource.data.usos is int && request.resource.data.usos >= 0
          && (!request.resource.data.get("individual", false)
            || (request.resource.data.limite == 1 && request.resource.data.usos <= 1
              && request.resource.data.oferta is list && request.resource.data.oferta.size() >= 1 && request.resource.data.oferta.size() <= 3
              && centavos(request.resource.data.subtotalOferta)
              && request.resource.data.minimo == request.resource.data.subtotalOferta
              && request.resource.data.destinatarioHash.matches("^[a-f0-9]{64}$")
              && getAfter(/databases/$(database)/documents/lojas/$(lojaId)/ofertasClientes/$(codigo)).data.telefone.matches("^[0-9]{10,11}$")));
      }

      // Telefone do destinatário e id do pedido ficam privados. Nunca na ficha pública.
      match /ofertasClientes/{codigo} {
        allow read: if membroDa(lojaId);
        allow create: if membroDa(lojaId)
          && request.resource.data.keys().hasOnly(["telefone", "nome", "criadoEm"])
          && request.resource.data.telefone.matches("^[0-9]{10,11}$")
          && texto(request.resource.data.nome, 80) && request.resource.data.criadoEm == request.time;
        allow update, delete: if false;
      }
      match /reservasCupons/{codigo} {
        allow read, delete: if membroDa(lojaId);
        allow create: if request.resource.data.keys().hasOnly(["pedidoId", "criadoEm"])
          && texto(request.resource.data.pedidoId, 100) && request.resource.data.criadoEm == request.time
          && !exists(/databases/$(database)/documents/lojas/$(lojaId)/pedidosEntrada/$(request.resource.data.pedidoId))
          && getAfter(/databases/$(database)/documents/lojas/$(lojaId)/pedidosEntrada/$(request.resource.data.pedidoId)).data.cupom == codigo
          && get(/databases/$(database)/documents/lojas/$(lojaId)/cupons/$(codigo)).data.individual == true;
        allow update: if false;
      }

      // ficha do cliente pelo número (decisão dele, 2026-10-17): quem sabe o número lê
      // o nome e o resumo dos pedidos, sem endereço e sem o id do pedido. Ninguém lista
      // as fichas fora do painel; a equipe lista o CRM somente da própria loja.
      match /clientes/{telefone} {
        allow get: if true;
        allow list: if membroDa(lojaId);
        allow write: if membroDa(lojaId) && telefone.matches("^[0-9]{10,11}$");
      }
    }

    // usuários do painel. O id é o e-mail em minúsculas: tirar e devolver o acesso
    // funciona sem apagar a conta do Auth, e um e-mail fica numa loja só.
    match /acessos/{email} {
      allow get: if logado() && (email == meuEmail() || membroDa(resource.data.lojaId));
      allow list: if logado() && membroDa(resource.data.lojaId);
      allow create: if logado() && membroDa(request.resource.data.lojaId)
        && request.resource.data.keys().hasOnly(["lojaId", "nome", "email", "dono", "trocarSenha", "criadoEm"])
        && request.resource.data.email == email
        && email.matches("^[^@ /]+@[^@ /]+[.][^@ /]+$") && email == email.lower()
        && texto(request.resource.data.nome, 80)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.trocarSenha is bool
        // o acesso do dono só o próprio dono cria, para si, e sem senha provisória
        && (request.resource.data.dono == true
          ? donoDa(request.resource.data.lojaId) && email == meuEmail() && request.resource.data.trocarSenha == false
          : request.resource.data.dono == false && request.resource.data.trocarSenha == true);
      // só a própria pessoa, e só para dizer que já trocou a senha provisória
      allow update: if logado() && email == meuEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["trocarSenha"])
        && request.resource.data.trocarSenha == false;
      allow delete: if logado() && membroDa(resource.data.lojaId) && resource.data.dono != true && email != meuEmail();
    }

    match /donos/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nome", "email", "whatsapp", "lojaId", "criadoEm"])
        && texto(request.resource.data.nome, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.whatsapp.matches("^[0-9]{10,11}$");
      allow update: if logado() && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
